# ==============================================================================
# INFRAKS Environment Variables Template (.env.example)
# Do NOT store actual secrets in this file.
# Copy this file to .env.local for local development.
# On Vercel: Add these variables in Project Settings -> Environment Variables.
# ==============================================================================

# Telegram Bot API Token for Order Form submissions
# Created via @BotFather (e.g. 1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Target Chat ID or Channel ID where order inquiries will be delivered
# (e.g. 193632181 or -100123456789)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Authoritative Production Domain for Canonical URLs & OpenGraph meta tags
VITE_SITE_URL=https://www.infraks.uz
