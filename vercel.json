{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin/index.html"
    },
    {
      "source": "/((?!api/|admin|uploads|assets|images|robots\\.txt|sitemap\\.xml|config\\.yml).*)",
      "destination": "/index.html"
    }
  ]
}
