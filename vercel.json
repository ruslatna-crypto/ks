{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/main", "destination": "/", "permanent": true },
    { "source": "/en/main", "destination": "/en", "permanent": true },
    { "source": "/sterilizaciya", "destination": "/steril", "permanent": true },
    { "source": "/en/sterilizaciya", "destination": "/en/steril", "permanent": true },
    { "source": "/grili", "destination": "/gril", "permanent": true },
    { "source": "/lechebnye-lampy", "destination": "/lamp", "permanent": true },
    { "source": "/cotton", "destination": "/hlopok", "permanent": true },
    { "source": "/en/hlopok", "destination": "/en/cotton", "permanent": true },
    { "source": "/lakokraska", "destination": "/paint", "permanent": true },
    { "source": "/kraska", "destination": "/paint", "permanent": true },
    { "source": "/en/lakokraska", "destination": "/en/paint", "permanent": true },
    { "source": "/en/kraska", "destination": "/en/paint", "permanent": true },
    { "source": "/lekcii", "destination": "/metodika", "permanent": true },
    { "source": "/contacts", "destination": "/contact", "permanent": true },
    { "source": "/clinical-cases", "destination": "/klinik", "permanent": true },
    { "source": "/clinical-cases/:id", "destination": "/klinik/:id", "permanent": true },
    { "source": "/en/clinical-cases", "destination": "/en/klinik", "permanent": true },
    { "source": "/en/clinical-cases/:id", "destination": "/en/klinik/:id", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://static.tildacdn.one https://mc.yandex.ru https://*.infraks.uz; connect-src 'self'; frame-src 'self' https://www.google.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap\\.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots\\.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
